# These run inside Linux containers / a POSIX shell; CRLF would break them.
*.sh  text eol=lf
*.sql text eol=lf
*.yml text eol=lf
nginx.conf text eol=lf
*.pem text eol=lf
*.mjs text eol=lf
*.js  text eol=lf
*.json text eol=lf

# Windows batch launchers: cmd.exe is happiest with CRLF, and the release zip is built on Linux.
*.cmd text eol=crlf
